{
  "id": "qishui",
  "name": "Qishui Music",
  "version": "0.7.0",
  "minAppVersion": "0.1.22",
  "main": "index.js",
  "playback": "stream",
  "permissions": {
    "network": [
      "api.qishui.com",
      "*.qishui.com",
      "beta-luna.douyin.com",
      "*.douyin.com",
      "*.douyinpic.com",
      "*.douyinvod.com",
      "*.douyincdn.com"
    ],
    "process": [
      "/usr/bin/base64",
      "/usr/bin/env"
    ]
  },
  "navigation": [
    {
      "builtin": "home",
      "title": "Home",
      "icon": "home"
    },
    {
      "page": "discover",
      "title": "Discover",
      "icon": "star"
    },
    {
      "page": "charts",
      "title": "Charts",
      "icon": "chart"
    },
    {
      "builtin": "liked",
      "title": "Liked Songs",
      "icon": "heart"
    },
    {
      "builtin": "savedAlbums",
      "title": "Saved Albums",
      "icon": "album"
    },
    {
      "page": "history",
      "title": "Recently Played",
      "icon": "calendar"
    }
  ]
}
